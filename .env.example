# ---------------------------------------------------------------
# Payment Orchestrator - environment variables
# Copy to .env and fill in. NEVER commit .env.
# TEST MODE ONLY: test API keys and testnets. No live keys, no mainnet.
# The app validates these at startup and refuses to boot if any is
# missing or looks like a live credential.
# ---------------------------------------------------------------

# --- App ---
NODE_ENV=development
API_PORT=3000
# Hard guard: the only accepted value. Anything else aborts startup.
PAYMENTS_MODE=test

# --- Database / queue (local docker compose) ---
DATABASE_URL=postgresql://orchestrator:orchestrator@localhost:5432/orchestrator
REDIS_URL=redis://localhost:6379

# --- Queues (BullMQ) ---
# Attempts before a job goes to the dead-letter queue, and the first retry delay (doubles each time).
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_MS=1000
# Redis key prefix; change it if several environments share one Redis.
QUEUE_PREFIX=po

# --- Stripe (test mode) ---
# Dashboard > Developers > API keys, with "Test mode" on. Must start with sk_test_.
STRIPE_SECRET_KEY=
# Same page, "Publishable key". Must start with pk_test_. Loads Stripe.js in the checkout.
STRIPE_PUBLISHABLE_KEY=
# Printed by `stripe listen --forward-to localhost:3000/v1/webhooks/stripe`. Starts with whsec_.
# Required together with STRIPE_SECRET_KEY: Stripe is enabled only when both are set.
STRIPE_WEBHOOK_SECRET=

# --- Mercado Pago (test credentials, ADR 0022) ---
# Enabled only when both are set. Your app > Pruebas > Credenciales de prueba: these are the
# credentials of the TEST SELLER, which Mercado Pago creates with its OWN application.
# Test tokens start with APP_USR- like live ones: at boot the app asks Mercado Pago (GET /users/me)
# and refuses to start unless the token belongs to a test user.
MERCADOPAGO_ACCESS_TOKEN=
# The test seller's application signs the notifications, not yours. Sign in to the developer panel
# AS the test seller (Pruebas > Cuentas de prueba), open its app > Webhooks > Configurar
# notificaciones, set the URL in production mode (test users' payments are live_mode: true),
# event "Pagos" > Guardar, and copy that app's secret key here.
MERCADOPAGO_WEBHOOK_SECRET=

# --- TRON Nile testnet (USDT TRC-20) ---
TRON_FULL_HOST=https://nile.trongrid.io
# Free key from trongrid.io (optional on Nile, raises rate limits).
TRONGRID_API_KEY=
# USDT test token on Nile (the only value the app accepts).
TRON_USDT_CONTRACT=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf
# Account xpub (m/44'/195'/0'). Generate a testnet one with: pnpm --filter @po/api crypto:xpub tron
# TRON payments are enabled only when host, contract and xpub are all set.
TRON_DEPOSIT_XPUB=
# How often the worker reads confirmed transfers.
TRON_POLL_INTERVAL_MS=10000
# Dev tool only (tron:payer): a throwaway TESTNET wallet that plays the customer.
# Create one with: pnpm --filter @po/api tron:payer new
TRON_TEST_PAYER_PRIVATE_KEY=

# --- Base Sepolia (USDC) ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532
# Circle's test USDC on Base Sepolia (the only value the app accepts).
BASE_USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Account xpub (m/44'/60'/0'). Generate a testnet one with: pnpm --filter @po/api crypto:xpub base
# Base payments are enabled only when RPC, chain id, contract and xpub are all set.
BASE_DEPOSIT_XPUB=
# Blocks on top of a transfer before it counts as paid: 120 x 0.2 s ≈ 24 s (ADR 0023).
BASE_CONFIRMATIONS=120
BASE_POLL_INTERVAL_MS=10000
# Dev tool only (base:payer): a throwaway TESTNET wallet that plays the customer.
# Create one with: pnpm --filter @po/api base:payer new
BASE_TEST_PAYER_PRIVATE_KEY=

# --- Dashboard auth ---
# Signs access tokens. Long random string, e.g. `openssl rand -base64 48` (min 32 chars).
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
LOGIN_RATE_LIMIT_PER_MINUTE=5
# Browser origins allowed to call the API (comma-separated).
DASHBOARD_ORIGINS=http://localhost:5173
# Encrypts webhook signing secrets at rest: 32 random bytes in base64.
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# or: openssl rand -base64 32
WEBHOOK_SECRETS_KEY=
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_MS=30000
# Public checkout page: each charge's checkoutUrl is this plus its token.
CHECKOUT_BASE_URL=http://localhost:5173/pay
