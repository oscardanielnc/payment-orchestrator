{
  "name": "@po/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "org:create": "nest build && node dist/modules/identity/presentation/cli/create-organization.cli.js",
    "dev:worker": "nest start --watch --entryFile worker",
    "start:worker": "node dist/worker.js",
    "crypto:xpub": "nest build && node dist/tools/generate-deposit-xpub.js",
    "tron:payer": "nest build && node dist/tools/tron-test-payer.js",
    "demo:tron": "nest build && node dist/tools/demo-tron-payment.js",
    "stripe:pay": "nest build && node dist/tools/stripe-pay.js",
    "user:create": "nest build && node dist/modules/identity/presentation/cli/create-user.cli.js"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "^4.0.1",
    "@nestjs-cls/transactional-adapter-prisma": "^2.0.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@node-rs/argon2": "^2.2.1",
    "@po/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "bullmq": "^6.3.11",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-cls": "^7.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@po/config": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "chokidar": "^5.0.0",
    "fast-check": "^4.10.2",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.0",
    "tronweb": "^6.5.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
