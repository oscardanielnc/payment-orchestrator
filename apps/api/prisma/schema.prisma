generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @db.Uuid
  name      String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  apiKeys   ApiKey[]
  charges   Charge[]

  @@map("organizations")
}

/// `id` is the public part of the token (po_<env>_<id>_<secret>); only a hash of the secret is stored.
model ApiKey {
  id             String       @id
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  secretHash     String       @map("secret_hash")
  createdAt      DateTime     @map("created_at") @db.Timestamptz(3)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt     DateTime?    @map("last_used_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("api_keys")
}

enum ChargeStatus {
  pending
  processing
  succeeded
  failed
  expired
}

/// Amounts are integers in the currency's minor unit (ADR 0005). `version` backs optimistic locking.
model Charge {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  amount         Decimal      @db.Decimal(78, 0)
  currency       String       @db.VarChar(10)
  status         ChargeStatus
  description    String?
  reference      String?
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @map("updated_at") @db.Timestamptz(3)
  version        Int
  organization   Organization     @relation(fields: [organizationId], references: [id])
  attempts       PaymentAttempt[]

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("charges")
}

/// Written in the same transaction as the change; a relay publishes and marks them (ADR 0008).
model OutboxEvent {
  id             String    @id @db.Uuid
  type           String
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id")
  organizationId String    @map("organization_id") @db.Uuid
  payload        Json
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(3)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
}

/// One row per (scope, key). Claimed and completed inside the request's transaction (ADR 0007).
model IdempotencyKey {
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  /// Exact JSON text: JSONB would reorder keys and break byte-identical replays.
  responseBody   String?  @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

enum AttemptStatus {
  pending
  succeeded
  failed
}

/// One try at paying a charge. A partial unique index (in the migration SQL) allows at most
/// one succeeded attempt per charge; Prisma cannot express partial indexes in the schema.
model PaymentAttempt {
  id                String        @id @db.Uuid
  chargeId          String        @map("charge_id") @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  method            String
  provider          String
  status            AttemptStatus
  externalReference String        @map("external_reference")
  instructions      Json
  failureReason     String?       @map("failure_reason")
  createdAt         DateTime      @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @map("updated_at") @db.Timestamptz(3)
  version           Int
  charge            Charge        @relation(fields: [chargeId], references: [id])

  @@unique([provider, externalReference])
  @@index([chargeId, createdAt])
  @@map("payment_attempts")
}

/// One receiving address per crypto payment attempt, derived from the xpub (ADR 0010).
model DepositAddress {
  id              String          @id @db.Uuid
  network         String
  address         String
  /// Lowercase 20-byte hex: how chain events name the recipient.
  matchKey        String          @map("match_key")
  derivationIndex Int             @map("derivation_index")
  attemptId       String          @unique @map("attempt_id") @db.Uuid
  chargeId        String          @map("charge_id") @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  currency        String          @db.VarChar(10)
  expectedAmount  Decimal         @map("expected_amount") @db.Decimal(78, 0)
  receivedAmount  Decimal         @map("received_amount") @db.Decimal(78, 0)
  createdAt       DateTime        @map("created_at") @db.Timestamptz(3)
  version         Int
  transfers       ChainTransfer[]

  @@unique([network, address])
  @@unique([network, matchKey])
  @@unique([network, derivationIndex])
  @@map("deposit_addresses")
}

/// Every confirmed transfer applied to a deposit. The unique key makes re-reads harmless.
model ChainTransfer {
  id               String         @id @default(uuid()) @db.Uuid
  network          String
  txHash           String         @map("tx_hash")
  eventIndex       Int            @map("event_index")
  depositAddressId String         @map("deposit_address_id") @db.Uuid
  fromMatchKey     String         @map("from_match_key")
  amount           Decimal        @db.Decimal(78, 0)
  blockNumber      BigInt         @map("block_number")
  blockTimestamp   DateTime       @map("block_timestamp") @db.Timestamptz(3)
  recordedAt       DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(3)
  depositAddress   DepositAddress @relation(fields: [depositAddressId], references: [id])

  @@unique([network, txHash, eventIndex])
  @@index([depositAddressId])
  @@map("chain_transfers")
}

/// Where each network's watcher resumes.
model WatcherCursor {
  network   String   @id
  cursor    String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("watcher_cursors")
}

enum NormalBalance {
  debit
  credit
}

enum LedgerTransactionStatus {
  pending
  posted
  archived
}

/// Created on first use. (code, currency) is the business identity (ADR 0009).
model LedgerAccount {
  id             String        @id @db.Uuid
  code           String
  currency       String        @db.VarChar(10)
  name           String
  normalBalance  NormalBalance @map("normal_balance")
  organizationId String?       @map("organization_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  entries        LedgerEntry[]

  @@unique([code, currency])
  @@index([organizationId])
  @@map("ledger_accounts")
}

/// Append-only. A trigger (migration SQL) rejects deletes and any change once not pending.
model LedgerTransaction {
  id             String                  @id @db.Uuid
  externalId     String                  @unique @map("external_id")
  organizationId String?                 @map("organization_id") @db.Uuid
  reference      String?
  description    String
  status         LedgerTransactionStatus
  effectiveAt    DateTime                @map("effective_at") @db.Timestamptz(3)
  postedAt       DateTime?               @map("posted_at") @db.Timestamptz(3)
  entries        LedgerEntry[]

  @@index([reference])
  @@map("ledger_transactions")
}

/// Immutable. A trigger (migration SQL) rejects UPDATE and DELETE.
model LedgerEntry {
  id            String            @id @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  accountId     String            @map("account_id") @db.Uuid
  direction     NormalBalance
  amount        Decimal           @db.Decimal(78, 0)
  currency      String            @db.VarChar(10)
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  account       LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([transactionId])
  @@map("ledger_entries")
}

enum InboundEventStatus {
  received
  processed
  ignored
  failed
}

/// Webhooks and chain transfers exactly as received; processed asynchronously (ADR 0008).
model InboundEvent {
  id          String             @id @db.Uuid
  provider    String
  externalId  String             @map("external_id")
  type        String
  /// Raw body as text: what the signature covered, byte for byte.
  payload     String
  status      InboundEventStatus
  attempts    Int                @default(0)
  lastError   String?            @map("last_error")
  receivedAt  DateTime           @map("received_at") @db.Timestamptz(3)
  processedAt DateTime?          @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@index([status, receivedAt])
  @@map("inbound_events")
}
