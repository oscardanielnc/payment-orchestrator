{
  "$schema": "https://swc.rs/schema.json",
  "exclude": [".*\\.spec\\.ts$"],
  "sourceMaps": true,
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "target": "es2024",
    "keepClassNames": true
  },
  "module": {
    "type": "commonjs"
  }
}
